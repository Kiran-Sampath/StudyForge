# Copy to .env and fill in the connection details from Supabase > Connect.
# Use Session pooler (port 5432) for IPv4 networks.
DB_HOST=aws-0-YOUR-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR-PROJECT-REF
# Use your database password, not a Supabase API key.
# Single quotes keep special characters literal; no URL encoding is needed.
DB_PASSWORD='replace-with-your-database-password'
DB_SSLMODE=require
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-project-publishable-or-anon-key
# Backend-only secret; never copy this into frontend/.env.local.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
SUPABASE_STORAGE_BUCKET=studyforge-note-images
# Comma-separated browser origins permitted to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
